<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="318.0" prefWidth="393.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.leonardoso.edaddeunapersona.PrimaryController">
   <children>
      <Label text="Fecha de nacimiento" />
      <TextField fx:id="txtFechaNacimiento" />
      <Button fx:id="btnCalcular" onAction="#calcularEdad" text="Calcular" />
      <Button fx:id="btnLimpiar" onAction="#limpiarPantalla" text="Limpiar" />
      <Label fx:id="lblResultado" text="" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
