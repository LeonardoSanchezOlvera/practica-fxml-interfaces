<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="650.0" prefWidth="350.0" spacing="12.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.leonardoso.cifrasydivisoresdeunnumero.PrimaryController">
   <children>
      <Label text="Ingrese un número" />
      <TextField fx:id="txtNumero" />
      
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Button onAction="#analizarNumero" text="Analizar" />
            <Button onAction="#limpiarPantalla" text="Limpiar" />
         </children>
      </HBox>

      <Label text="Cantidad de cifras" />
      <TextField fx:id="txtCantidadCifras" editable="false" />

      <Label text="Suma de cifras impares" />
      <TextField fx:id="txtSumaImpares" editable="false" />

      <Label text="Suma de cifras pares" />
      <TextField fx:id="txtSumaPares" editable="false" />

      <Label text="Suma total de cifras" />
      <TextField fx:id="txtSumaTotal" editable="false" />

      <Label text="Cifra mayor" />
      <TextField fx:id="txtCifraMayor" editable="false" />

      <Label text="Cifra menor" />
      <TextField fx:id="txtCifraMenor" editable="false" />

      <Label text="Divisores" />
      <TextArea fx:id="txtAreaDivisores" editable="false" prefHeight="150.0" prefWidth="200.0" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>