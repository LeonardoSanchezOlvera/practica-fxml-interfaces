<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="350.0" spacing="10.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.leonardoso.controldegastospersonales.PrimaryController">
   <children>
      <Label style="-fx-font-size: 15px; -fx-font-weight: bold;" text="Control de Gastos Semanales" />
      
      <Label text="Alimentación" />
      <TextField fx:id="txtAlimentacion" />

      <Label text="Refrigerios" />
      <TextField fx:id="txtRefrigerios" />

      <Label text="Transporte" />
      <TextField fx:id="txtTransporte" />

      <Label text="Telefonía" />
      <TextField fx:id="txtTelefonia" />

      <Label text="Otros" />
      <TextField fx:id="txtOtros" />

      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Button onAction="#calcularEstadisticas" text="Calcular estadísticas" />
            <Button onAction="#limpiarPantalla" text="Limpiar" />
         </children>
      </HBox>

      <Label style="-fx-font-weight: bold;" text="Estadísticas" />

      <Label text="Total semanal" />
      <TextField fx:id="txtTotalSemanal" editable="false" />

      <Label text="Gasto más alto" />
      <TextField fx:id="txtGastoMasAlto" editable="false" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>